  "branches": [
    {
      "node_id": "west",
      "rules": [
        "m > w"
      ],
      "note": "Shared innovation defining the west subgroup, so the subgrouping is recoverable from the data rather than only asserted by the tree."
    },
    {
      "node_id": "d1",
      "rules": [
        "b > p"
      ],
      "note": "MERGER. *b and *p both surface as p here, and no rule scoped to d1 can undo it. Only d2, which keeps them apart, can disambiguate the west node."
    },
    {
      "node_id": "d2",
      "rules": [
        "ʔ > Ø / #_"
      ],
      "note": "LOSS. d1 is the only branch in the whole family that keeps the initial glottal stop, so every other node depends on it. The DSL has no insertion, so no rule scoped to a losing branch can restore it; the segment is reachable only because d1's own candidate carries it into the beam."
    },
    {
      "node_id": "east",
      "rules": [
        "t > s",
        "k > t"
      ],
      "note": "CHAIN SHIFT. *t > s must run before *k > t or every k ends up as s. The child-to-parent cascade must therefore run t > k before s > t; the reverse order turns t a s i into k a k i."
    },
    {
      "node_id": "east_a",
      "rules": [
        "ʔ > Ø / #_"
      ]
    },
    {
      "node_id": "d3",
      "rules": []
    },
    {
      "node_id": "d4",
      "rules": [
        "a > e / _ i"
      ],
      "note": "CONDITIONED SPLIT. Proto *a becomes e before i and stays a elsewhere, so the parent value cannot be recovered without the context. The oracle in tools/oracle_ceiling.py is context-free and cannot express this; the DSL can."
    },
    {
      "node_id": "d5",
      "rules": [
        "ʔ > Ø / #_",
        "l > r"
      ]
    }
  ],
