# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/
.venv/
venv/

# OS / editor artifacts
.DS_Store
.gemini/

# Local Claude Code config; the canonical skill source is committed at skills/
.claude/

# Secrets. Keys belong in the environment; the harness reads them by variable
# name (--api-key-env) and never writes them to a config, event, trajectory, or
# checkpoint. These patterns exist so a key pasted into the tree cannot be
# committed by accident.
*KEY.txt
*_key.txt
.env
.env.*

# Run outputs
runs/
reconstruction_events.jsonl
reconstruction_result.json
trajectories.jsonl

# User-managed local corpus checkouts, described in data/README.md.
# These are multi-GB and must never be committed.
data/glottolog/
data/lexibank/
