 "run_id": "run-pre-change",
 "schema_version": "2.0",
 "tool_definitions": [
  {
   "description": "Commit ordered individually validated rules and anomalies. Rules must change their targets; use rules=[] for identity. Each rule needs a successful same-session test_sound_law validation: give its ID as the per-rule validation_call_id, or omit that field and the harness resolves the unique validation with the identical DSL and child scope. supporting_form_ids defaults to that validation's forms. Set cascade_validation_call_id only to an ID returned by test_rule_cascade; omit it if no cascade preview was run.",
   "name": "commit_reconstruction",
   "parameters": {
    "$defs": {
     "AnomalyReport": {
      "additionalProperties": false,
      "properties": {
       "anomaly_type": {
        "$ref": "#/$defs/AnomalyType"
       },
       "concept_id": {
        "anyOf": [
         {
          "minLength": 1,
          "type": "string"
         },
         {
          "type": "null"
         }
        ],
        "default": null,
        "title": "Concept Id"
       },
       "explanation": {
        "minLength": 1,
        "title": "Explanation",
        "type": "string"
       },
       "form_id": {
        "anyOf": [
         {
          "minLength": 1,
          "type": "string"
         },
         {
          "type": "null"
         }
        ],
        "default": null,
        "title": "Form Id"
       }
      },
      "required": [
       "anomaly_type",
       "explanation"
      ],
      "title": "AnomalyReport",
      "type": "object"
     },
     "AnomalyType": {
      "enum": [
       "loanword",
       "morphological_leveling",
       "taboo_deformation",
       "unknown_irregularity"
      ],
      "title": "AnomalyType",
      "type": "string"
     },
     "CommittedSoundRule": {
      "additionalProperties": false,
      "properties": {
       "confidence": {
        "description": "Your confidence in this rule, in the open-closed interval (0, 1]. This is your own judgement; the harness cannot derive it. The deterministic beam uses it as a score weight.",
        "exclusiveMinimum": 0.0,
        "maximum": 1.0,
        "title": "Confidence",
        "type": "number"
       },
       "direction": {
        "const": "child_to_parent",
        "default": "child_to_parent",
        "description": "Fixed. Rules are operational child-to-parent transformations; the harness never inverts a conventional forward historical law.",
        "title": "Direction",
        "type": "string"
       },
       "dsl": {
        "description": "The child-to-parent rule text, character-identical to the 'dsl' argument of the test_sound_law call that validated it, for example 'f > p / #_'.",
        "minLength": 1,
        "title": "Dsl",
        "type": "string"
       },
       "rationale": {
        "anyOf": [
         {
          "minLength": 1,
          "type": "string"
         },
         {
          "type": "null"
         }
        ],
        "default": null,
        "description": "Optional rule-specific justification. The required top-level 'summary' already carries the reasoning for the whole commit.",
        "title": "Rationale"
       },
       "rule_id": {
        "anyOf": [
         {
          "minLength": 1,
          "type": "string"
         },
         {
          "type": "null"
         }
        ],
        "default": null,
        "description": "Optional stable label. When omitted, the harness deterministically derives one from the exact DSL and child scope.",
        "title": "Rule Id"
       },
       "source_child_ids": {
        "description": "Active child node IDs this rule is applied to. Must equal the source_child_ids of the test_sound_law call that validated it.",
        "items": {
         "minLength": 1,
         "type": "string"
        },
        "minItems": 1,
        "title": "Source Child Ids",
        "type": "array"
       },
       "supporting_form_ids": {
        "default": [],
        "description": "Exact form IDs this rule applied to. Optional: when omitted it defaults to the supporting_form_ids reported by the resolved validation. When supplied it must be a subset of them.",
        "items": {
         "minLength": 1,
         "type": "string"
        },
        "title": "Supporting Form Ids",
        "type": "array"
       },
       "validation_call_id": {
        "anyOf": [
         {
          "minLength": 1,
          "type": "string"
         },
         {
          "type": "null"
         }
        ],
        "default": null,
        "description": "The validation_call_id returned by the test_sound_law call that tested this exact dsl and this exact source_child_ids. It is per-rule and is never the top-level cascade_validation_call_id, which only ever holds a test_rule_cascade ID. Optional: when omitted the harness resolves it automatically, but only when exactly one successful same-session test_sound_law validation matches this rule's DSL, child scope, and segmentation overlay. Supply it explicitly when several validations would match.",
        "title": "Validation Call Id"
       }
      },
      "required": [
       "dsl",
       "source_child_ids",
       "confidence"
      ],
      "title": "CommittedSoundRule",
      "type": "object"
     }
    },
    "additionalProperties": false,
    "properties": {
     "anomalies": {
      "description": "Every unresolved irregularity, each naming a form_id or concept_id. Use an empty list when none remain.",
      "items": {
       "$ref": "#/$defs/AnomalyReport"
      },
      "title": "Anomalies",
      "type": "array"
     },
     "cascade_validation_call_id": {
      "anyOf": [
       {
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Only the validation_call_id returned by a successful test_rule_cascade call. Omit this field if test_rule_cascade was not called; never use a test_sound_law call ID here. A test_sound_law ID belongs in the per-rule validation_call_id.",
      "title": "Cascade Validation Call Id"
     },
     "node_id": {
      "description": "The node_id of the node being reconstructed, exactly as given in the prompt payload.",
      "minLength": 1,
      "title": "Node Id",
      "type": "string"
     },
     "rules": {
      "description": "The ordered rule cascade to commit. Use an empty list for an identity reconstruction.",
      "items": {
       "$ref": "#/$defs/CommittedSoundRule"
      },
      "title": "Rules",
      "type": "array"
     },
     "segmentation_overlay_id": {
      "anyOf": [
       {
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "The segmentation_overlay_id returned by segment_morphemes, when the committed rules were validated against an overlay. Omit it when no overlay was used.",
      "title": "Segmentation Overlay Id"
     },
     "summary": {
      "description": "A concise statement of the reconstruction and the evidence supporting it.",
      "minLength": 1,
      "title": "Summary",
      "type": "string"
     }
    },
    "required": [
     "node_id",
     "rules",
     "anomalies",
     "summary"
    ],
    "title": "CommitReconstructionArgs",
    "type": "object"
   }
